{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postStartCommand": "bash .devcontainer/check.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "openai.chatgpt"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true
      }
    }
  }
}